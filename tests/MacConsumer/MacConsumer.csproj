<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Consumer</AssemblyName>
    <TargetFramework>net10.0-macos</TargetFramework>
    <SupportedOSPlatformVersion>12.0</SupportedOSPlatformVersion>
    <SelfContained>true</SelfContained>
    <UseAppHost>true</UseAppHost>
    <CreateAppBundle>true</CreateAppBundle>
    <CreatePackage>false</CreatePackage>
    <UseHardenedRuntime>true</UseHardenedRuntime>
    <ApplicationManifest>Info.plist</ApplicationManifest>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCodeSigning>false</EnableCodeSigning>
    <EnablePackageSigning>false</EnablePackageSigning>
    <OfficeCliPackageVersion Condition="'$(OfficeCliPackageVersion)' == ''">999.0.0</OfficeCliPackageVersion>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Consumer/Program.cs" Link="Program.cs" />
    <PackageReference Include="OfficeCLI" Version="[$(OfficeCliPackageVersion)]" />
    <PackageReference Include="System.IO.Packaging" Version="10.0.11" />
  </ItemGroup>

  <!-- Exercise the same final-sidecar integration used by Everywhere's Apple bundle. -->
  <Target Name="CopyOfficeCliToBundle" AfterTargets="_CreateAppBundle">
    <Copy SourceFiles="$(TargetDir)officecli;$(OfficeCliDepsFile);$(OfficeCliRuntimeConfig)" DestinationFolder="$(AppBundleDir)/Contents/MonoBundle" />
    <Exec Command="chmod +x &quot;$(AppBundleDir)/Contents/MonoBundle/officecli&quot;" />
  </Target>

  <!-- Match Everywhere's signing order, using an ad-hoc identity without release secrets. -->
  <Target Name="SignSmokeBundle" AfterTargets="Publish">
    <Exec Command="xattr -cr &quot;$(AppBundleDir)&quot;" />
    <Exec Command="find &quot;$(AppBundleDir)/Contents/MonoBundle&quot; \( -name &quot;*.dylib&quot; -o -name &quot;*.so&quot; -o -name &quot;createdump&quot; \) -exec codesign --force --sign - --timestamp=none --options runtime &quot;{}&quot; \;" />
    <Exec Command="codesign --force --sign - --timestamp=none --options runtime --entitlements &quot;$(CodesignEntitlements)&quot; &quot;$(AppBundleDir)/Contents/MonoBundle/officecli&quot;" />
    <Exec Command="codesign --force --sign - --timestamp=none --options runtime --entitlements &quot;$(CodesignEntitlements)&quot; &quot;$(AppBundleDir)&quot;" />
    <Exec Command="codesign --verify --deep --strict --verbose=2 &quot;$(AppBundleDir)&quot;" />
  </Target>

  <Target Name="WriteSmokeReferences" AfterTargets="Publish" DependsOnTargets="SignSmokeBundle">
    <!-- Compare against the SDK's final trimmed graph, independently of the CLI copies. -->
    <Copy SourceFiles="$(IntermediateDepsFilePath)" DestinationFiles="$(PublishDir)smoke-reference/Consumer.deps.json" />
    <Copy SourceFiles="$(ProjectRuntimeConfigFilePath)" DestinationFiles="$(PublishDir)smoke-reference/Consumer.runtimeconfig.json" />
    <ConvertToAbsolutePath Paths="$(AppBundleDir)">
      <Output TaskParameter="AbsolutePaths" PropertyName="_SmokeBundleDirectory" />
    </ConvertToAbsolutePath>
    <WriteLinesToFile File="$(PublishDir)bundle-path.txt" Lines="$(_SmokeBundleDirectory)" Overwrite="true" />
  </Target>
</Project>
