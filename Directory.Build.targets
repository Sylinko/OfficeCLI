<Project>
  <!-- Older targets retain their existing async compilation model. -->
  <PropertyGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp' And $([MSBuild]::VersionGreaterThanOrEquals('$(TargetFrameworkVersion)', '11.0'))">
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>
</Project>